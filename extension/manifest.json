{
  "manifest_version": 3,
  "name": "Webby",
  "version": "0.0.1",
  "description": "Tells the Webby Mac app which page you are on so your notes stick to it.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
